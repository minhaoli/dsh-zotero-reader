{
  "name": "dsh-zotero-reader",
  "version": "0.1.1",
  "description": "Zotero 伴读：在会话中识别 AI 搜出的文献，右侧栏打开本地 PDF，带页码问答 / 一键中文版 / 划词翻译（保留公式）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "config.js",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhaoli/dsh-zotero-reader.git"
  },
  "homepage": "https://github.com/minhaoli/dsh-zotero-reader#readme",
  "author": {
    "name": "minhaoli"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "zotero",
    "pdf",
    "paper-reader"
  ]
}
